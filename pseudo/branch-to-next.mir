# RUN: %llc -mtriple=amdgcn -mcpu=gfx1150 -verify-machineinstrs -run-pass=branch-folder %s -o - | %FileCheck %s -DOP=SI_DEBUGGING_ENABLED_BRANCH
# RUN: %llc -mtriple=amdgcn -mcpu=gfx1150 -verify-machineinstrs -run-pass=branch-folder,si-late-branch-lowering,branch-relaxation %s -o - | %FileCheck %s -DOP=S_CBRANCH_CDBGSYS_OR_USER
# RUN: %llc -mtriple=amdgcn -mcpu=gfx1150 -verify-machineinstrs -run-pass=block-placement -enable-tail-merge=false -tail-dup-placement=false %s -o - | %FileCheck %s -DOP=SI_DEBUGGING_ENABLED_BRANCH
# RUN: %llc -mtriple=amdgcn -mcpu=gfx1150 -verify-machineinstrs -run-pass=block-placement,si-late-branch-lowering,branch-relaxation -enable-tail-merge=false -tail-dup-placement=false %s -o - | %FileCheck %s -DOP=S_CBRANCH_CDBGSYS_OR_USER

# CHECK-LABEL: name: {{ *}}branch_to_next
# CHECK: body:
# CHECK: [[OP]] %bb.{{[0-9]+}}
# CHECK-NOT: [[OP]]
# CHECK: ...

---
name: branch_to_next
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1

    S_NOP 0
    SI_DEBUGGING_ENABLED_BRANCH %bb.1

  bb.1:
    S_ENDPGM 0
...
