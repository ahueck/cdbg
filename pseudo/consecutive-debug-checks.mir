# RUN: %llc -mtriple=amdgcn -mcpu=gfx1150 -verify-machineinstrs -run-pass=branch-folder %s -o - | %FileCheck %s -DOP=SI_DEBUGGING_ENABLED_BRANCH
# RUN: %llc -mtriple=amdgcn -mcpu=gfx1150 -verify-machineinstrs -run-pass=branch-folder,si-late-branch-lowering,branch-relaxation %s -o - | %FileCheck %s -DOP=S_CBRANCH_CDBGSYS_OR_USER

# CHECK-LABEL: name: {{ *}}consecutive_debug_checks
# CHECK: body:
# CHECK: [[OP]] %bb.[[HANDLER:[0-9]+]]
# CHECK: bb.{{[0-9]+}}:
# CHECK: [[OP]] %bb.[[HANDLER]]
# CHECK-NOT: [[OP]]
# CHECK: bb.[[HANDLER]]:
# CHECK-NEXT: S_TRAP 2
# CHECK-NOT: [[OP]]
# CHECK: ...

---
name: consecutive_debug_checks
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.3, %bb.1

    SI_DEBUGGING_ENABLED_BRANCH %bb.3

  bb.1:
    successors: %bb.3, %bb.2

    SI_DEBUGGING_ENABLED_BRANCH %bb.3

  bb.2:
    S_ENDPGM 0

  bb.3:
    S_TRAP 2
    S_ENDPGM 0
...
